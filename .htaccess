RewriteEngine On

# Définir le répertoire de base
RewriteBase /

# Évite les redirections infinies avec Render (HTTPS géré par proxy)
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Rediriger www vers non-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Protection des fichiers sensibles
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protection du dossier service
<DirectoryMatch "^/service/">
    # Autoriser l'accès aux fichiers PHP spécifiques
    <FilesMatch "^(check\.access|health|paydunya_callback)\.php$">
        Order allow,deny
        Allow from all
    </FilesMatch>
    
    # Bloquer l'accès à tous les autres fichiers
    <FilesMatch ".*">
        Order allow,deny
        Deny from all
    </FilesMatch>
</DirectoryMatch>

# Protection des fichiers de configuration
<FilesMatch "^(config\.php|db_utils\.php|\.env|composer\.(json|lock))$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protection du dossier vendor
<DirectoryMatch "^/vendor/">
    Order allow,deny
    Deny from all
</DirectoryMatch>

# Protection du dossier db
<DirectoryMatch "^/db/">
    Order allow,deny
    Deny from all
</FilesMatch>

# Redirection des erreurs
ErrorDocument 403 /error.php?code=403
ErrorDocument 404 /error.php?code=404
ErrorDocument 500 /error.php?code=500

# Configuration PHP
php_value upload_max_filesize 10M
php_value post_max_size 10M
php_value max_execution_time 300
php_value max_input_time 300

# Forcer HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Protection contre l'accès aux fichiers .php dans les dossiers publics
RewriteCond %{REQUEST_URI} !^/index\.php
RewriteCond %{REQUEST_URI} !^/login\.php
RewriteCond %{REQUEST_URI} !^/register\.php
RewriteCond %{REQUEST_URI} !^/error\.php
RewriteCond %{REQUEST_URI} \.php$
RewriteRule ^(.*)$ /error.php?code=403 [L]

# Autoriser l'accès aux fichiers statiques
<FilesMatch "\.(css|js|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot)$">
    Order allow,deny
    Allow from all
</FilesMatch>

# Headers de sécurité
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Compression GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>

# Cache des fichiers statiques
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
    ExpiresByType text/html "access plus 1 day"
    ExpiresByType application/xhtml+xml "access plus 1 day"
</IfModule>
