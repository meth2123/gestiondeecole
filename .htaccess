# Activer le moteur de réécriture
RewriteEngine On

# Définir le répertoire de base
RewriteBase /gestion/

# Activer l'affichage des erreurs en développement
php_flag display_errors on
php_value error_reporting E_ALL
php_value error_log "C:/wamp64/logs/php_error.log"

# Protection des fichiers sensibles
RewriteRule ^\. - [F,L]

# Protection du dossier service
RewriteRule ^service/(?!check\.access\.php|health\.php|paydunya_callback\.php) - [F,L]

# Protection des fichiers de configuration
RewriteRule ^(config\.php|db_utils\.php|\.env|composer\.(json|lock))$ - [F,L]

# Protection du dossier vendor
RewriteRule ^vendor/ - [F,L]

# Protection du dossier db
RewriteRule ^db/ - [F,L]

# Redirection des erreurs
ErrorDocument 403 /gestion/error.php?code=403
ErrorDocument 404 /gestion/error.php?code=404
ErrorDocument 500 /gestion/error.php?code=500

# Configuration PHP
php_value upload_max_filesize 10M
php_value post_max_size 10M
php_value max_execution_time 300
php_value max_input_time 300
php_value memory_limit 256M

# Protection contre l'accès aux fichiers .php dans les dossiers publics
RewriteCond %{REQUEST_URI} !^/gestion/index\.php
RewriteCond %{REQUEST_URI} !^/gestion/login\.php
RewriteCond %{REQUEST_URI} !^/gestion/register\.php
RewriteCond %{REQUEST_URI} !^/gestion/error\.php
RewriteCond %{REQUEST_URI} !^/gestion/service/check\.access\.php
RewriteCond %{REQUEST_URI} !^/gestion/service/health\.php
RewriteCond %{REQUEST_URI} !^/gestion/service/paydunya_callback\.php
RewriteCond %{REQUEST_URI} \.php$
RewriteRule ^(.*)$ /gestion/error.php?code=403 [L]

# Autoriser l'accès aux fichiers statiques
RewriteCond %{REQUEST_URI} \.(css|js|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot)$ [NC]
RewriteRule .* - [L]

# Headers de sécurité
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Compression GZIP (version WAMP)
<IfModule mod_deflate.c>
    SetOutputFilter DEFLATE
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png)$ no-gzip dont-vary
    SetEnvIfNoCase Request_URI \.(?:exe|t?gz|zip|bz2|sit|rar)$ no-gzip dont-vary
    SetEnvIfNoCase Request_URI \.pdf$ no-gzip dont-vary
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
</IfModule>

# Cache des fichiers statiques
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType text/html "access plus 1 day"
</IfModule>
